<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrimbleConnector</RootNamespace>
    <AssemblyName>TrimbleConnector</AssemblyName>
    <Version>2.3.2</Version>
    <AssemblyVersion>2.3.2.0</AssemblyVersion>
    <FileVersion>2.3.2.0</FileVersion>
    <InformationalVersion>2.3.2</InformationalVersion>
    <Product>Trimble Connector</Product>
    <AssemblyTitle>Trimble Connector</AssemblyTitle>
    <Description>Cross-platform daemon that synchronizes a local network folder with Trimble Connect.</Description>
    <UserSecretsId>trimble-connector-daemon</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="SanitizePublishOutput" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_SanitizeFiles Include="$(PublishDir)appsettings.Development.json" />
      <_SanitizeFiles Include="$(PublishDir).application_credentials" />
      <_SanitizeFiles Include="$(PublishDir)**\*.token" />
      <_SanitizeFiles Include="$(PublishDir)data\**\*" />
    </ItemGroup>
    <Delete Files="@(_SanitizeFiles)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(PublishDir)data" />
    <Exec
      Command="python3 &quot;$(MSBuildProjectDirectory)/scripts/prepare-factory-appsettings.py&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(PublishDir)&quot;"
      Condition="Exists('$(MSBuildProjectDirectory)/scripts/prepare-factory-appsettings.py')" />
  </Target>

</Project>
